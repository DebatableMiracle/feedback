---
import BaseLayout from "../layouts/BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getCollection, getEntry } from "astro:content";

const articles = (await getCollection("articles"))
	.filter((article) => article.data.published)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 5);

const logs = (await getCollection("logs"))
	.filter((log) => log.data.published)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 5);

const feedback = await getEntry("pages", "feedback");
const { Content } = feedback ? await feedback.render() : { Content: null };
---

<BaseLayout title="Feedback" description={feedback?.data.subtitle ?? "A public loop for personal logs and refined articles. Also some dumb stuff I do."}>
	<section class="min-h-[60vh] sm:min-h-[70vh] flex flex-col justify-center pb-12 mb-16 sm:mb-20">
		<h1 class="text-5xl sm:text-6xl md:text-7xl font-serif font-bold text-text mb-4 tracking-tight leading-[1.1]">
			{feedback?.data.title ?? "Feedback"}
		</h1>
		<p class="text-xl sm:text-2xl font-serif text-secondary mb-6 sm:mb-8 font-normal leading-snug">
			{feedback?.data.subtitle ?? "A place for things I’m figuring out."}
		</p>
		<div class="text-secondary text-base sm:text-lg leading-relaxed mb-8 max-w-[55ch]">
			{Content ? (
				<Content />
			) : (
				<p>
					I’m Anubhav, a masters student at IIT Delhi working on robotics and AI.
					I build things, think about how they work, and occasionally write about them —
					from technical stuff to philosophy to whatever else catches my attention.
				</p>
			)}
		</div>
		<div class="flex items-center gap-6 sm:gap-8 font-mono text-sm sm:text-base">
			<a
				href="/articles"
				class="text-secondary hover:text-accent transition-colors inline-flex items-center gap-1 group"
			>
				<span>Articles</span>
				<span class="group-hover:translate-x-1 transition-transform">→</span>
			</a>
			<a
				href="/logs"
				class="text-secondary hover:text-accent transition-colors inline-flex items-center gap-1 group"
			>
				<span>Logs</span>
				<span class="group-hover:translate-x-1 transition-transform">→</span>
			</a>
		</div>
	</section>

	<section class="mb-16">
		<h2
			class="text-sm font-semibold uppercase tracking-wider text-secondary mb-6 border-b border-border pb-2"
		>
			Articles
		</h2>
		<ul class="space-y-4">
			{
				articles.map((article) => (
					<li class="flex justify-between items-baseline group">
						<a
							href={`/articles/${article.slug}/`}
							class="text-lg font-serif font-semibold group-hover:text-accent transition-colors"
						>
							{article.data.title}
						</a>
						<span class="text-sm font-mono text-secondary whitespace-nowrap shrink-0 ml-4">
							<FormattedDate date={article.data.date} />
						</span>
					</li>
				))
			}
		</ul>
		<div class="mt-6 text-sm">
			<a
				href="/articles"
				class="text-secondary hover:text-accent transition-colors"
				>View all articles →</a
			>
		</div>
	</section>

	<section class="mb-16">
		<h2
			class="text-sm font-semibold uppercase tracking-wider text-secondary mb-6 border-b border-border pb-2"
		>
			Recent Logs
		</h2>
		<ul class="space-y-3">
			{
				logs.map((log) => (
					<li>
						<a
							href={`/logs/${log.slug}/`}
							class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4 group font-mono text-sm group"
						>
							<div class="flex items-baseline gap-4 min-w-[200px]">
								<span class="text-secondary min-w-[3ch] group-hover:text-accent transition-colors">
									#{log.data.log_number}
								</span>
								<span class="group-hover:text-accent transition-colors">
									<FormattedDate date={log.data.date} />
								</span>
							</div>
							{log.data.subtitle && (
								<span class="text-secondaryText text-xs italic group-hover:text-accent transition-colors sm:ml-4">
									{log.data.subtitle}
								</span>
							)}
						</a>
					</li>
				))
			}
		</ul>
		<div class="mt-6 text-sm">
			<a
				href="/logs"
				class="text-secondary hover:text-accent transition-colors"
				>View all logs →</a
			>
		</div>
	</section>
</BaseLayout>
