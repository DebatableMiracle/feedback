<!--
  3-state Theme Toggle: light → dark → coffee → light
  Shows icon of CURRENT theme. Click to cycle to next.
  Stores preference in localStorage as "light" | "dark" | "coffee"
-->
<button
	id="theme-toggle"
	type="button"
	aria-label="Cycle theme"
	title="Cycle theme"
	class="text-secondary hover:text-accent transition-colors p-1 rounded cursor-pointer flex items-center justify-center"
>
	<!-- Sun: light mode icon -->
	<svg id="icon-light" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round"
			d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
	</svg>

	<!-- Moon: dark mode icon -->
	<svg id="icon-dark" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round"
			d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
	</svg>

	<!-- Coffee cup: coffee mode icon -->
	<svg id="icon-coffee" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
		<!-- steam -->
		<path stroke-linecap="round" stroke-linejoin="round" d="M7 3c0 1 1 1 1 2s-1 1-1 2M11 3c0 1 1 1 1 2s-1 1-1 2" />
		<!-- cup body -->
		<path stroke-linecap="round" stroke-linejoin="round" d="M5 8h11l-1.5 8a1 1 0 0 1-1 .875H7.5a1 1 0 0 1-1-.875L5 8Z" />
		<!-- handle -->
		<path stroke-linecap="round" stroke-linejoin="round" d="M16 10h1.5a2 2 0 0 1 0 4H16" />
		<!-- saucer -->
		<path stroke-linecap="round" stroke-linejoin="round" d="M4 17h13" />
	</svg>
</button>

<script is:inline>
	const THEMES = ['light', 'coffee', 'dark'];

	function getTheme() {
		const stored = localStorage.getItem('theme');
		if (stored && THEMES.includes(stored)) return stored;
		// Respect system preference for initial visit
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	}

	function applyTheme(theme) {
		const html = document.documentElement;
		// Remove all theme classes
		html.classList.remove('dark', 'coffee');
		if (theme === 'dark') html.classList.add('dark');
		if (theme === 'coffee') html.classList.add('coffee');
		localStorage.setItem('theme', theme);

		// Update icons
		document.getElementById('icon-light')?.classList.toggle('hidden', theme !== 'light');
		document.getElementById('icon-dark')?.classList.toggle('hidden', theme !== 'dark');
		document.getElementById('icon-coffee')?.classList.toggle('hidden', theme !== 'coffee');

		// Notify Giscus if present
		const iframe = document.querySelector('iframe.giscus-frame');
		if (iframe) {
			const giscusTheme = theme === 'dark' ? 'transparent_dark' : 'light';
			iframe.contentWindow.postMessage(
				{ giscus: { setConfig: { theme: giscusTheme } } },
				'https://giscus.app'
			);
		}
	}

	function nextTheme(current) {
		const idx = THEMES.indexOf(current);
		return THEMES[(idx + 1) % THEMES.length];
	}

	function setup() {
		const btn = document.getElementById('theme-toggle');
		const currentTheme = getTheme();
		applyTheme(currentTheme);

		btn?.addEventListener('click', () => {
			const current = getTheme();
			applyTheme(nextTheme(current));
		});
	}

	// Run on initial load and after Astro page transitions
	setup();
	document.addEventListener('astro:after-swap', setup);
</script>
